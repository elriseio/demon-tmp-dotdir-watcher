# Example configuration for demon-tmp-dotdir-watcher.
#
# Copy to /etc/tmp-watcher.toml and edit as needed.
# All keys except those marked required are optional; missing fields fall
# back to the embedded default at config/default.toml, which the Rust
# binary bakes in via include_str! and uses when /etc/tmp-watcher.toml is
# absent.
#
# Field documentation: docs/components/tmp-watcher.md.
# Runtime contract: ARCHITECTURE.md (invariants 1-7).
#
# Env overrides (DEMON_<UPPER_SNAKE_KEY>) take precedence over this file.
# See src/main.rs::print_usage for the full list.

log = { level = "info" }

[runtime]
# Grace period between SIGTERM and forced exit. Type=oneshot systemd
# activation per ARCHITECTURE.md invariant 2; daemon exits after one
# poll tick (per CR-005), so this only bites on a SIGTERM during the
# tick.
shutdown_timeout_sec = 30

[paths]
# Scan roots that the walker enumerates each tick. Must be non-empty
# (ARCHITECTURE.md invariant 4). Add /home at your own risk: a host
# with chmod 700 /home/<user> directories drops the /home arm of the
# threat model — see CR-006 + RUNBOOK.md "Daemon not running".
scan_roots = ["/tmp", "/home", "/var/tmp"]

# Bounded by invariant 6. Larger values are rejected at boot.
scan_maxdepth = 3

# Sliding window (minutes) for the candidate filter. Larger windows
# surface older candidates; smaller windows reduce false positives
# from short-lived dot-directories (e.g. systemd-private-*).
scan_window_minutes = 1440

# ADR-0002: host-side overlay-fs scan for Docker overlay2 layers.
# Set enabled = false on hosts without Docker to silence the
# overlay_scan_skipped journal event.
[paths.overlay_scan]
enabled = true
roots = ["/var/lib/docker/overlay2"]
# Bounded by invariant 6.
maxdepth = 3
# When true, only dot-directories under the layer's tmp/ are walked
# (per operator direction 2026-08-13).
dotdir_only = true

[ioc]
# Operator-curated IOC list. One SHA-256 per line. Missing file is a
# baseline state (empty matcher; every candidate classifies as
# Decision::Unknown). See ARCHITECTURE.md invariant 4.
ioc_list = "/etc/tmp-watcher.iocs"

# Operator-side report of Unknown candidates. Read-only for the daemon;
# the daemon appends one line per Unknown observation.
proposed_iocs = "/etc/tmp-watcher.proposed.iocs"

# ioc_archive_ref = "<path>"   # optional; set per-host in /etc/tmp-watcher.toml
# when forensic auto-refresh is enabled. Do NOT set a concrete path
# here — the embedded default stays None (per AR-011/AR-010).

[allowlist]
# Operator-curated allowlist (one glob per line).
allowlist = "/etc/tmp-watcher.allowlist"

# Bounded by invariant 6. Larger values are rejected at boot.
max_files_per_dir = 10

[actions]
# Quarantine IOC matches with chmod 000 (idempotent). Per ARCHITECTURE.md
# invariant 7, the daemon never uses rm -rf.
quarantine_on_ioc_match = true

# Log WARNING for unknown non-allowlisted dotdirs. Triggers
# emit_unknown and feeds the proposer pipeline.
alert_on_unknown = true

# ntfy_url = "https://ntfy.sh/<your-topic>"   # optional; the operator
# phones/chat receiver. Defaults to None in the embedded config
# (per AR-011 / AR-010). When unset, the per-tick summary is
# journal-only. See docs/contracts/webhook-payload.md for the contract.
# Override per host via DEMON_ACTIONS_NTFY_URL.
